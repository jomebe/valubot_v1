# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# VALORANT API Config (e.g., HenrikDev API)
VALORANT_API_KEY=your_henrikdev_api_key_here

# NVIDIA NIM AI review
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_FALLBACK_API_KEY=
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4.1-flash

# Session Security Configuration
# Encryption key used to encrypt Riot authentication tokens. Must be a secure random string.
ENCRYPTION_KEY=your_secret_encryption_key_here

# 로그인 처리 방식 (manual: 로컬호스트 복사붙여넣기, rso: 라이엇 RSO 페이지 콜백)
LOGIN_FLOW=manual

# Firebase Configuration (Optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Voice Configuration
VOICE_CYCLE_ROLE_ID=
RENDER_EXTERNAL_URL=
PORT=10000
